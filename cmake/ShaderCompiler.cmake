option(GSX_SHADER_COMPILER "Enable game shader conversion with reeot-XenosRecomp and DXC" OFF)
if(NOT GSX_SHADER_COMPILER)
    return()
endif()
foreach(dependency reeot-XenosRecomp/XenosRecomp/shader_recompiler.cpp spirv-cross/spirv_glsl.hpp)
    if(NOT EXISTS "${PROJECT_SOURCE_DIR}/external/${dependency}")
        message(FATAL_ERROR "Missing shader tools: run git submodule update --init --recursive")
    endif()
endforeach()
set(ZSTD_BUILD_PROGRAMS OFF CACHE BOOL "" FORCE)
set(ZSTD_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(ZSTD_BUILD_SHARED OFF CACHE BOOL "" FORCE)
add_subdirectory("${PROJECT_SOURCE_DIR}/external/reeot-XenosRecomp" "${PROJECT_BINARY_DIR}/external/reeot-XenosRecomp" EXCLUDE_FROM_ALL)
set(SPIRV_CROSS_CLI OFF CACHE BOOL "" FORCE)
set(SPIRV_CROSS_ENABLE_TESTS OFF CACHE BOOL "" FORCE)
set(SPIRV_CROSS_ENABLE_HLSL OFF CACHE BOOL "" FORCE)
set(SPIRV_CROSS_ENABLE_MSL OFF CACHE BOOL "" FORCE)
set(SPIRV_CROSS_ENABLE_CPP OFF CACHE BOOL "" FORCE)
set(SPIRV_CROSS_ENABLE_C_API OFF CACHE BOOL "" FORCE)
add_subdirectory("${PROJECT_SOURCE_DIR}/external/spirv-cross" "${PROJECT_BINARY_DIR}/external/spirv-cross" EXCLUDE_FROM_ALL)
get_target_property(GSX_DXC_RUNTIME Microsoft::DirectXShaderCompiler IMPORTED_LOCATION)
if(NOT EXISTS "${GSX_DXC_RUNTIME}")
    message(FATAL_ERROR "Missing DXC runtime for this platform: ${GSX_DXC_RUNTIME}. Supply a compatible build or configure with GSX_SHADER_COMPILER=OFF.")
endif()
set(GSX_XENOS_DIR "${PROJECT_SOURCE_DIR}/external/reeot-XenosRecomp/XenosRecomp")
file(READ "${GSX_XENOS_DIR}/shader_common.h" GSX_SHADER_COMMON)
file(WRITE "${PROJECT_BINARY_DIR}/gsx_shader_common.h" "static constexpr char GSXShaderCommon[] = R\"GSXCOMMON(${GSX_SHADER_COMMON})GSXCOMMON\";\n")
add_library(gsx_shader_compiler STATIC
    "${PROJECT_SOURCE_DIR}/src/shader/shader_compiler.cpp"
    "${GSX_XENOS_DIR}/shader_recompiler.cpp")
target_include_directories(gsx_shader_compiler PRIVATE
    "${GSX_XENOS_DIR}" "${PROJECT_SOURCE_DIR}/src" "${PROJECT_BINARY_DIR}"
    "${PROJECT_SOURCE_DIR}/external/reeot-XenosRecomp/thirdparty/smol-v/source")
target_link_libraries(gsx_shader_compiler PRIVATE Microsoft::DirectXShaderCompiler xxHash::xxhash libzstd_static fmt::fmt spirv-cross-glsl)
target_precompile_headers(gsx_shader_compiler PRIVATE "${GSX_XENOS_DIR}/pch.h")
target_compile_definitions(gsx_shader_compiler PRIVATE REEOT_RECOMP)
target_compile_features(gsx_shader_compiler PRIVATE cxx_std_17)
if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    target_compile_options(gsx_shader_compiler PRIVATE -fms-extensions -Wno-null-arithmetic)
endif()
